{
  "name": "capfence",
  "version": "0.1.0",
  "description": "Capability-diff security for AI agent skills and MCP servers.",
  "type": "module",
  "bin": {
    "capfence": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pretest": "pnpm run build",
    "test:watch": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "demo": "node examples/mcp-demo/run-demo.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "video:install": "pnpm add -D remotion @remotion/cli @remotion/player",
    "video:preview": "remotion studio video/src/index.tsx",
    "video:render": "remotion render video/src/index.tsx CapFenceEvaluation video/out/capfence-evaluation.mp4",
    "video:check": "remotion compositions video/src/index.tsx",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai-agent",
    "mcp",
    "security",
    "capability",
    "policy",
    "supply-chain"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/O3O-OvO/CapFence.git"
  },
  "bugs": {
    "url": "https://github.com/O3O-OvO/CapFence/issues"
  },
  "homepage": "https://github.com/O3O-OvO/CapFence#readme",
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.7.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.522",
    "@remotion/player": "4.0.522",
    "@types/node": "^22.10.2",
    "remotion": "4.0.522",
    "vitest": "^3.0.5"
  }
}
